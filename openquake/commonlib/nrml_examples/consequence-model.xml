<?xml version="1.0" encoding="utf-8"?>
<nrml
xmlns="http://openquake.org/xmlns/nrml/0.5"
xmlns:gml="http://www.opengis.net/gml"
>
    <consequenceModel
    assetCategory="buildings"
    id="example"
    lossCategory="structural"
    >
        <description>
            ln cf | tax1 | zcov
        </description>
        <limitStates>
            ds1 ds2 ds3 ds4
        </limitStates>
        <consequenceFunction
        dist="LN"
        id="tax1"
        >
            <params ls="ds1" mean="0.04000" stddev="0.00000"/>
            <params ls="ds2" mean="0.16000" stddev="0.00000"/>
            <params ls="ds3" mean="0.32000" stddev="0.00000"/>
            <params ls="ds4" mean="0.64000" stddev="0.00000"/>
        </consequenceFunction>
    </consequenceModel>
</nrml>
